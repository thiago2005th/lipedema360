---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { artigos, AREAS, TIPOS, fmtData, tituloExibido, resumoCurto } from '../../lib/data';

export function getStaticPaths() {
  return artigos.map((a) => ({ params: { pmid: a.pmid }, props: { a } }));
}
const { a } = Astro.props;
const relacionados = artigos
  .filter((x) => x.pmid !== a.pmid && x.area === a.area)
  .sort((x, y) => (y.data > x.data ? 1 : -1))
  .slice(0, 3);
---
<Base titulo={tituloExibido(a)} descricao={resumoCurto(a, 160)}>
  <article class="artigo">
    <div class="meta">
      <a class={`tag tipo-${a.tipo}`} href={`/tipos/${a.tipo}`}>{TIPOS[a.tipo]}</a>
      <a class="tag area" href={`/areas/${a.area}`}>{AREAS[a.area]?.nome}</a>
    </div>
    <h1>{tituloExibido(a)}</h1>
    {a.titulo_pt && <p class="orig">{a.titulo}</p>}
    <p class="fonte">
      {a.autores.join(', ')}<br />
      <i>{a.revista}</i> · {fmtData(a.data)}
      {a.doi && <> · DOI <a href={`https://doi.org/${a.doi}`} target="_blank" rel="noopener">{a.doi}</a></>}
      · PMID {a.pmid}
    </p>

    {a.resumo_pt ? (
      <>
        <h2>Resumo em português</h2>
        <div class="bloco pt">
          <p>{a.resumo_pt}</p>
          {a.pontos_chave && a.pontos_chave.length > 0 && (
            <>
              <p><b>Pontos-chave</b></p>
              <ul class="pontos">{a.pontos_chave.map((p) => <li>{p}</li>)}</ul>
            </>
          )}
          {a.relevancia_clinica && <p style="margin-top:10px"><b>Relevância clínica.</b> {a.relevancia_clinica}</p>}
        </div>
        <h2>Abstract original</h2>
        <div class="bloco"><p class="abstract">{a.resumo_original}</p></div>
      </>
    ) : (
      <>
        <h2>Abstract original</h2>
        {a.resumo_original ? (
          <div class="bloco"><p class="abstract">{a.resumo_original}</p></div>
        ) : (
          <p class="aviso">Este registro não tem abstract no PubMed. Consulte o artigo completo pelo link abaixo.</p>
        )}
      </>
    )}

    <div class="botoes">
      <a class="btn" href={a.url} target="_blank" rel="noopener">Ver no PubMed</a>
      {a.doi && <a class="btn sec" href={`https://doi.org/${a.doi}`} target="_blank" rel="noopener">Artigo completo (DOI)</a>}
      {a.pmcid && <a class="btn sec" href={`https://pmc.ncbi.nlm.nih.gov/articles/${a.pmcid}/`} target="_blank" rel="noopener">Texto completo gratuito (PMC)</a>}
    </div>

    {(a.keywords.length > 0 || a.mesh.length > 0) && (
      <div class="kw">
        {[...a.keywords, ...a.mesh].slice(0, 14).map((k) => <span class="tag">{k}</span>)}
      </div>
    )}
  </article>

  {relacionados.length > 0 && (
    <>
      <h2 class="secao">Mais em {AREAS[a.area]?.nome}</h2>
      <div class="grid">{relacionados.map((r) => <Card a={r} />)}</div>
    </>
  )}
</Base>
