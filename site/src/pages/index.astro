---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { artigos, AREAS } from '../lib/data';

const hoje = new Date();
const corte = new Date(hoje.getTime() - 30 * 86400000).toISOString().slice(0, 10);
const corte365 = new Date(hoje.getTime() - 365 * 86400000).toISOString().slice(0, 10);
const recentes = artigos.filter((a) => a.data >= corte);
const noAno = artigos.filter((a) => a.data >= corte365).length;
const ultimos = artigos.slice(0, 24);
const destaques = artigos
  .filter((a) => a.data >= corte365 && (a.destaque || ['guideline', 'meta', 'rct'].includes(a.tipo)))
  .slice(0, 6);
const contagem: Record<string, number> = {};
for (const a of artigos) contagem[a.area] = (contagem[a.area] || 0) + 1;
---
<Base>
  <section class="hero">
    <h1>A ciência do lipedema, atualizada todo dia.</h1>
    <p>Tudo o que sai no PubMed sobre lipedema, selecionado por tipo de evidência e área clínica, para médicos, nutricionistas e fisioterapeutas.</p>
    <div class="stats">
      <div><b>{recentes.length}</b> artigos nos últimos 30 dias</div>
      <div><b>{noAno}</b> no último ano</div>
      <div><b>{artigos.length}</b> na base completa</div>
    </div>
  </section>

  {destaques.length > 0 && (
    <>
      <h2 class="secao">Melhor evidência do ano <a href="/destaques">ver todos →</a></h2>
      <div class="grid">
        {destaques.map((a) => <Card a={a} />)}
      </div>
    </>
  )}

  <h2 class="secao">Publicados recentemente <a href="/boletim">ver boletim semanal →</a></h2>
  <div class="grid">
    {ultimos.map((a) => <Card a={a} />)}
  </div>

  <h2 class="secao">Explorar por área</h2>
  <div class="areas-grid">
    {Object.entries(AREAS).map(([k, v]) => (
      <a class="area-box" href={`/areas/${k}`}>
        <h3>{v.nome}</h3>
        <p>{v.desc}</p>
        <p class="n">{contagem[k] || 0} artigos</p>
      </a>
    ))}
  </div>
</Base>
