---
import Base from '../../layouts/Base.astro';
import { artigos, AREAS, TIPOS, fmtData, tituloExibido, nivelEvidencia } from '../../lib/data';
import { ANALISES } from '../../lib/analises';

export function getStaticPaths() {
  return ANALISES.map((an) => ({ params: { pmid: an.pmid }, props: { an } }));
}
const { an } = Astro.props;
const a = artigos.find((x) => x.pmid === an.pmid)!;
const nivel = nivelEvidencia(a);
---
<Base titulo={`Análise crítica: ${an.titulo}`} descricao={an.pergunta}>
  <article class="artigo-main" style="max-width:820px">
    <p class="eyebrow">Análise crítica Lipedema360 · exemplo</p>
    <h1 style="font-size:clamp(1.9rem,3.6vw,2.8rem);line-height:1.1;margin:0 0 20px">{an.titulo}</h1>
    <p class="aviso-ferr" style="font-size:.84rem;color:var(--muted);border-left:2px solid var(--gold-dim);padding:6px 0 6px 16px;margin:0 0 32px;line-height:1.6">
      Exemplo do formato do plano Profissional. Elaborada a partir do abstract; o texto completo ainda não foi revisado, e os itens que dependem dele estão listados no fim. Deve ser revisada pelo autor antes de uso como análise final.
    </p>

    <div class="card" style="margin-bottom:36px;border:1px solid var(--line)">
      <div class="card-topo"><div class="meta"><span class="tag">{TIPOS[a.tipo]}</span><span class="tag area">{AREAS[a.area]?.curto}</span></div>
        <span class={`evid ${nivel >= 4 ? 'alta' : ''}`}><span class="barras">{[1, 2, 3, 4, 5].map((i) => <i class={i <= nivel ? 'on' : ''}></i>)}</span> {nivel} de 5</span></div>
      <h3><a href={`/artigos/${a.pmid}`}>{tituloExibido(a)}</a></h3>
      <p class="fonte">{a.autores.slice(0, 3).join(', ')} et al. · <i>{a.revista}</i> · {fmtData(a.data)}{a.doi && <> · DOI <a href={`https://doi.org/${a.doi}`} target="_blank" rel="noopener" style="color:var(--gold)">{a.doi}</a></>}</p>
    </div>

    <div class="artigo">
      <div style="grid-column:1/-1">
        <h2 class="sub" style="font-family:var(--sans);font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin:0 0 12px">Pergunta clínica</h2>
        <p style="font-size:1.12rem;color:var(--fg);line-height:1.65;margin:0 0 36px">{an.pergunta}</p>

        {[
          ['Desenho e população', an.desenho],
          ['Resultado principal', an.resultado],
          ['Riscos de viés e limitações', an.vieses],
          ['Aplicabilidade', an.aplicabilidade],
        ].map(([t, itens]) => (
          <>
            <h2 class="sub" style="font-family:var(--sans);font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin:0 0 12px">{t}</h2>
            <ul style="margin:0 0 36px;padding-left:20px;color:var(--fg-2);line-height:1.75">
              {(itens as string[]).map((i) => <li style="margin-bottom:8px">{i}</li>)}
            </ul>
          </>
        ))}

        <div class="res" style="margin:0 0 36px">
          <p class="kicker">O que muda na conduta</p>
          <p style="font-size:1.06rem;color:var(--fg)">{an.conduta}</p>
        </div>

        <h2 class="sub" style="font-family:var(--sans);font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin:0 0 12px">A conferir no texto completo</h2>
        <ul style="margin:0 0 36px;padding-left:20px;color:var(--muted);line-height:1.7;font-size:.92rem">
          {an.pendente.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>

    <div class="botoes">
      <a class="btn" href={`/artigos/${a.pmid}`}>Ver o estudo</a>
      <a class="btn sec" href="/analises">Outras análises</a>
      <a class="btn sec" href="/premium">Conhecer o plano Profissional</a>
    </div>
  </article>
</Base>
