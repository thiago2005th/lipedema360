---
import Base from '../layouts/Base.astro';
import { AREAS, TIPOS } from '../lib/data';
---
<Base titulo="Busca avançada" descricao="Busque em toda a literatura sobre lipedema por tema, tipo de estudo, área clínica e nível de evidência.">
  <section class="hero" style="padding-bottom:0;margin-bottom:0;border:0">
    <p class="eyebrow">Busca avançada</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);max-width:none">Encontre o estudo que sustenta a sua conduta.</h1>
  </section>

  <div class="painel-busca">
    <div class="campo"><input id="q" type="search" placeholder="Tema, técnica, desfecho, autor ou revista" aria-label="Buscar" autocomplete="off" autofocus /></div>
    <div class="filtros">
      <select id="f-area" aria-label="Área clínica">
        <option value="">Todas as áreas</option>
        {Object.entries(AREAS).map(([k, v]) => <option value={k}>{v.nome}</option>)}
      </select>
      <select id="f-tipo" aria-label="Tipo de estudo">
        <option value="">Todos os tipos</option>
        {Object.entries(TIPOS).map(([k, v]) => <option value={k}>{v}</option>)}
      </select>
      <select id="f-ano" aria-label="Período">
        <option value="">Qualquer data</option>
        <option value="1">Último ano</option>
        <option value="3">Últimos 3 anos</option>
        <option value="5">Últimos 5 anos</option>
      </select>
      <select id="f-ordem" aria-label="Ordenar">
        <option value="rel">Mais relevantes</option>
        <option value="data">Mais recentes</option>
        <option value="evid">Maior evidência</option>
      </select>
      <label class="chk"><input type="checkbox" id="f-alta" /> Só alta evidência</label>
      <label class="chk"><input type="checkbox" id="f-salvos" /> Meus salvos</label>
      <button class="limpar" id="limpar" type="button">Limpar</button>
    </div>
  </div>

  <div class="resultado-info"><span id="contagem">Carregando…</span></div>
  <div class="grid" id="res"></div>
  <div class="vazio" id="vazio" hidden>Nenhum estudo encontrado com esses filtros.</div>
  <p style="text-align:center;margin-top:32px"><button class="btn sec" id="mais" type="button" hidden>Mostrar mais</button></p>

  <script define:vars={{ AREAS, TIPOS }}>
    (function () {
      var norm = function (s) { return (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); };
      var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      var meses = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
      var fmt = function (iso) { var p = iso.split('-'); return Number(p[2]) + ' ' + meses[Number(p[1]) - 1] + ' ' + p[0]; };
      var $ = function (id) { return document.getElementById(id); };
      var dados = [], pagina = 1, TAM = 30, atual = [];

      // Tradução de termos clínicos PT -> EN, porque a base ainda é majoritariamente em inglês.
      var SIN = {
        'lipoaspiracao': ['liposuction', 'lipectomy'], 'lipoescultura': ['liposuction'], 'cirurgia': ['surgery', 'surgical', 'liposuction'],
        'cetogenica': ['ketogenic', 'keto'], 'cetogenico': ['ketogenic'], 'dieta': ['diet', 'dietary'], 'nutricao': ['nutrition', 'diet'],
        'compressao': ['compression'], 'drenagem': ['drainage', 'lymphatic'], 'linfatica': ['lymphatic'], 'linfedema': ['lymphedema', 'lymphoedema'],
        'exercicio': ['exercise', 'training'], 'dor': ['pain'], 'obesidade': ['obesity'], 'gordura': ['fat', 'adipose'], 'adiposo': ['adipose'],
        'ultrassom': ['ultrasound', 'ultrasonography'], 'ressonancia': ['mri', 'magnetic resonance'], 'diagnostico': ['diagnosis', 'diagnostic'],
        'tratamento': ['treatment', 'therapy', 'management'], 'terapia': ['therapy'], 'qualidade': ['quality of life'], 'depressao': ['depression'],
        'genetica': ['genetic', 'genes'], 'inflamacao': ['inflammation'], 'hormonio': ['hormone', 'estrogen'], 'estrogeno': ['estrogen', 'oestrogen'],
        'mulheres': ['women', 'female'], 'metformina': ['metformin'], 'semaglutida': ['semaglutide', 'glp-1'], 'bariatrica': ['bariatric'],
        'radiofrequencia': ['radiofrequency'], 'laser': ['laser'], 'fisioterapia': ['physiotherapy', 'physical therapy'], 'prevalencia': ['prevalence'],
        'metanalise': ['meta-analysis', 'metaanalysis'], 'diretriz': ['guideline', 'consensus'], 'consenso': ['consensus', 'guideline']
      };
      function alternativas(t) {
        var alts = [t];
        Object.keys(SIN).forEach(function (k) {
          if (k === t || (t.length >= 4 && k.indexOf(t) === 0)) alts = alts.concat(SIN[k]);
        });
        return alts;
      }

      var params = new URLSearchParams(location.search);
      $('q').value = params.get('q') || '';
      $('f-area').value = params.get('area') || '';
      $('f-tipo').value = params.get('tipo') || '';
      $('f-salvos').checked = params.get('salvos') === '1';

      function filtrar() {
        var termos = norm($('q').value).split(/\s+/).filter(Boolean);
        var area = $('f-area').value, tipo = $('f-tipo').value, anos = Number($('f-ano').value) || 0;
        var alta = $('f-alta').checked, soSalvos = $('f-salvos').checked;
        var salvos = (window.l360 && window.l360.salvos()) || [];
        var corte = anos ? new Date(Date.now() - anos * 365.25 * 86400000).toISOString().slice(0, 10) : '';
        var r = dados.filter(function (a) {
          if (area && a.a !== area) return false;
          if (tipo && a.y !== tipo) return false;
          if (corte && a.d < corte) return false;
          if (alta && a.e < 4) return false;
          if (soSalvos && salvos.indexOf(a.p) < 0) return false;
          for (var i = 0; i < termos.length; i++) {
            var ok = alternativas(termos[i]).some(function (alt) { return a.h.indexOf(alt) > -1; });
            if (!ok) return false;
          }
          return true;
        });
        var ord = $('f-ordem').value;
        r.forEach(function (a) {
          var s = 0, t = norm(a.t);
          termos.forEach(function (x) { if (alternativas(x).some(function (alt) { return t.indexOf(alt) > -1; })) s += 3; });
          a._s = s + a.e * 0.4;
        });
        if (ord === 'data') r.sort(function (x, y) { return x.d < y.d ? 1 : -1; });
        else if (ord === 'evid') r.sort(function (x, y) { return y.e - x.e || (x.d < y.d ? 1 : -1); });
        else r.sort(function (x, y) { return y._s - x._s || (x.d < y.d ? 1 : -1); });
        atual = r; pagina = 1; desenhar(termos);
        var u = new URLSearchParams();
        if ($('q').value) u.set('q', $('q').value);
        if (area) u.set('area', area);
        if (tipo) u.set('tipo', tipo);
        if (soSalvos) u.set('salvos', '1');
        history.replaceState(null, '', u.toString() ? '?' + u.toString() : location.pathname);
      }

      function marca(txt, termos) {
        var h = esc(txt);
        termos.forEach(function (t) {
          if (t.length < 3) return;
          var re = new RegExp('(' + t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
          h = h.replace(re, '<mark>$1</mark>');
        });
        return h;
      }

      function card(a, termos) {
        var barras = '';
        for (var i = 1; i <= 5; i++) barras += '<i class="' + (i <= a.e ? 'on' : '') + '"></i>';
        return '<article class="card"><div class="card-topo"><div class="meta"><a class="tag" href="/tipos/' + a.y + '">' + esc(TIPOS[a.y] || a.y) + '</a><a class="tag area" href="/areas/' + a.a + '">' + esc((AREAS[a.a] || {}).curto || a.a) + '</a></div>' +
          '<span class="evid ' + (a.e >= 4 ? 'alta' : '') + '" title="Nível de evidência estimado pelo tipo de estudo: ' + a.e + ' de 5"><span class="barras" aria-hidden="true">' + barras + '</span></span></div>' +
          '<h3><a href="/artigos/' + a.p + '">' + marca(a.t, termos) + '</a></h3>' +
          (a.o ? '<p class="orig">' + esc(a.o) + '</p>' : '') +
          '<div class="card-topo" style="margin:14px 0 0"><p class="fonte">' + esc(a.u) + ' · <i>' + esc(a.r) + '</i> · ' + fmt(a.d) + '</p>' +
          '<div class="card-acoes"><button class="comparar" type="button" data-comp="' + a.p + '" aria-pressed="false">Comparar</button><button class="salvar" type="button" data-save="' + a.p + '" aria-pressed="false">Salvar</button></div></div></article>';
      }

      function desenhar(termos) {
        var fatia = atual.slice(0, pagina * TAM);
        $('res').innerHTML = fatia.length ? fatia.map(function (a) { return card(a, termos); }).join('') : '';
        $('res').style.display = fatia.length ? '' : 'none';
        $('vazio').hidden = fatia.length > 0;
        $('contagem').innerHTML = '<b>' + atual.length + '</b> ' + (atual.length === 1 ? 'estudo' : 'estudos') + (fatia.length < atual.length ? ' · exibindo ' + fatia.length : '');
        $('mais').hidden = fatia.length >= atual.length;
        if (window.l360) window.l360.sync();
      }

      ['q', 'f-area', 'f-tipo', 'f-ano', 'f-ordem', 'f-alta', 'f-salvos'].forEach(function (id) {
        $(id).addEventListener(id === 'q' ? 'input' : 'change', filtrar);
      });
      $('mais').addEventListener('click', function () { pagina++; desenhar(norm($('q').value).split(/\s+/).filter(Boolean)); });
      $('limpar').addEventListener('click', function () {
        $('q').value = ''; $('f-area').value = ''; $('f-tipo').value = ''; $('f-ano').value = ''; $('f-ordem').value = 'rel'; $('f-alta').checked = false; $('f-salvos').checked = false; filtrar();
      });
      document.addEventListener('l360:salvos', function () { if ($('f-salvos').checked) filtrar(); });

      fetch('/search.json').then(function (r) { return r.json(); }).then(function (d) { dados = d; filtrar(); })
        .catch(function () { $('contagem').textContent = 'Não foi possível carregar a busca. Recarregue a página.'; });
    })();
  </script>
</Base>
