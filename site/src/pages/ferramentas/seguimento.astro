---
export const prerender = false;
import Ferramenta from '../../layouts/Ferramenta.astro';
const fontes = [
  { ref: 'Buso G, et al. Obesity, 2019;27(10):1567-1576, citando Reich-Schupke et al. (diretriz S1 alemã, 2017).', nota: 'Parâmetros de acompanhamento recomendados: índice de atividade diária, peso, IMC, relação cintura-quadril, cintura-estatura e medidas de circunferência e volume dos membros.' },
  { ref: 'Volume por segmentos de cone truncado: método geométrico clássico de estimativa de volume de membro a partir de circunferências.', nota: 'Estimativa. Não substitui a perimetria óptica (perômetro). Não há ponto de corte validado para lipedema, que costuma ser simétrico.' },
];
const sitios = [
  ['cint', 'Cintura', false], ['quad', 'Quadril', false],
  ['braco', 'Braço', true], ['coxap', 'Coxa proximal', true], ['coxam', 'Coxa média', true], ['joelho', 'Joelho', true], ['pant', 'Panturrilha (maior)', true], ['torn', 'Tornozelo', true],
];
---
<Ferramenta slug="seguimento" fontes={fontes}>
  <h2 class="sub">Paciente e visita</h2>
  <div class="campos">
    <div class="fld"><label for="cod">Código do paciente</label><input id="cod" placeholder="ex.: L-014" autocomplete="off" /><span class="un">use código, não o nome</span></div>
    <div class="fld"><label for="data">Data da visita</label><input id="data" type="date" /></div>
    <div class="fld"><label for="peso">Peso (kg)</label><input id="peso" inputmode="decimal" /></div>
    <div class="fld"><label for="dor">Dor (0 a 10)</label><input id="dor" inputmode="decimal" placeholder="escala numérica" /></div>
  </div>

  <h2 class="sub">Circunferências (cm)</h2>
  <div class="tabela-rolavel">
    <table class="grade">
      <thead><tr><th>Local</th><th>Direita</th><th>Esquerda</th></tr></thead>
      <tbody>
        {sitios.map(([id, nome, par]) => (
          par
            ? <tr><td>{nome}</td><td><input id={`${id}D`} inputmode="decimal" /></td><td><input id={`${id}E`} inputmode="decimal" /></td></tr>
            : <tr><td>{nome}</td><td colspan="2"><input id={`${id}D`} inputmode="decimal" /></td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="acoes-ferr">
    <button class="btn" id="b-salvar" type="button">Salvar visita</button>
    <button class="btn sec" id="b-csv" type="button">Exportar CSV</button>
  </div>

  <div class="res neutro" id="res">
    <p class="kicker">Evolução</p>
    <div id="evol"><p>Informe o código do paciente e salve a primeira visita.</p></div>
    <div id="graf" style="margin-top:14px"></div>
    <div class="grafico-papel" id="grafico"></div>
    <div id="leitura" class="leitura"></div>
  </div>

  <h2 class="sub">Calculadora de volume do membro (cones truncados)</h2>
  <p style="color:var(--muted);font-size:.88rem;margin:0 0 12px">Meça a circunferência em níveis equidistantes, do mais distal ao mais proximal, e informe a distância entre os níveis.</p>
  <div class="campos">
    <div class="fld"><label for="vh">Distância entre níveis (cm)</label><input id="vh" inputmode="decimal" value="10" /></div>
    <div class="fld"><label for="vd">Circunferências, direita (cm)</label><input id="vd" placeholder="22, 28, 33, 36, 38" /></div>
    <div class="fld"><label for="ve">Circunferências, esquerda (cm)</label><input id="ve" placeholder="22, 28, 33, 36, 38" /></div>
  </div>
  <div class="res neutro" style="margin-top:18px"><div id="vout"><p>Informe ao menos dois níveis.</p></div></div>

  <script is:inline>
    (function () {
      var SIT = [['cint', false], ['quad', false], ['braco', true], ['coxap', true], ['coxam', true], ['joelho', true], ['pant', true], ['torn', true]];
      var NOMES = { cint: 'Cintura', quad: 'Quadril', braco: 'Braço', coxap: 'Coxa prox.', coxam: 'Coxa média', joelho: 'Joelho', pant: 'Panturrilha', torn: 'Tornozelo' };
      document.getElementById('data').value = new Date().toISOString().slice(0, 10);
      var KS = 'l360_seg';
      function lerTudo() { try { return JSON.parse(localStorage.getItem(KS) || '{}'); } catch (e) { return {}; } }
      function gravarTudo(o) { try { localStorage.setItem(KS, JSON.stringify(o)); } catch (e) {} }
      function cod() { return document.getElementById('cod').value.trim().toUpperCase(); }
      function fd(iso) { var p = iso.split('-'); return p[2] + '/' + p[1] + '/' + p[0]; }
      function d1(a, b) { return (a == null || b == null) ? '—' : ((a - b > 0 ? '+' : '') + f1(a - b)); }

      function visitas() { var t = lerTudo(); return (t[cod()] || []).slice().sort(function (a, b) { return a.data < b.data ? -1 : 1; }); }

      function spark(v, chave, rot) {
        var pts = v.map(function (x, i) { return { i: i, y: x[chave] }; }).filter(function (p) { return p.y != null; });
        if (pts.length < 2) return '';
        var w = 300, h = 60, mn = Math.min.apply(null, pts.map(function (p) { return p.y; })), mx = Math.max.apply(null, pts.map(function (p) { return p.y; }));
        if (mx === mn) { mx += 1; mn -= 1; }
        var xs = function (i) { return 8 + i * (w - 16) / (v.length - 1); }, ys = function (y) { return h - 8 - (y - mn) * (h - 16) / (mx - mn); };
        var d = pts.map(function (p, k) { return (k ? 'L' : 'M') + xs(p.i).toFixed(1) + ' ' + ys(p.y).toFixed(1); }).join(' ');
        var dots = pts.map(function (p) { return '<circle cx="' + xs(p.i).toFixed(1) + '" cy="' + ys(p.y).toFixed(1) + '" r="3" fill="#e0c48f"/>'; }).join('');
        return '<div style="display:inline-block;margin-right:28px"><div style="font-size:.72rem;color:var(--muted);letter-spacing:.1em;text-transform:uppercase;margin-bottom:4px">' + rot + ': ' + f1(pts[0].y) + ' → ' + f1(pts[pts.length - 1].y) + '</div><svg width="' + w + '" height="' + h + '" viewBox="0 0 ' + w + ' ' + h + '"><path d="' + d + '" fill="none" stroke="#c9a66b" stroke-width="1.5"/>' + dots + '</svg></div>';
      }

      function ddmm(iso) { var p = iso.split('-'); return p[2] + '/' + p[1]; }
      var CIRC = [['coxamD', 'Coxa média D'], ['coxamE', 'Coxa média E'], ['pantD', 'Panturrilha D'], ['pantE', 'Panturrilha E'], ['tornD', 'Tornozelo D'], ['tornE', 'Tornozelo E'], ['quadD', 'Quadril'], ['cintD', 'Cintura']];
      function graficoSeg() {
        var v = visitas(); if (v.length < 2 || !window.l360doc) return '';
        var datas = v.map(function (x) { return ddmm(x.data); }), out = '';
        var series = [];
        CIRC.forEach(function (c) {
          var base = null; v.forEach(function (x) { if (base == null && x[c[0]] != null) base = x[c[0]]; });
          if (base == null) return;
          var pts = v.map(function (x) { return x[c[0]] == null ? null : +(x[c[0]] - base).toFixed(1); });
          if (pts.filter(function (p) { return p != null; }).length >= 2) series.push({ nome: c[1], pontos: pts });
        });
        series = series.slice(0, 4);
        if (series.length) out += '<h5>Circunferências: variação desde a 1ª visita (cm)</h5>' + window.l360doc.linhas(datas, series, 560, 200, ' cm');
        var pp = v.map(function (x) { return x.peso; });
        if (pp.filter(function (p) { return p != null; }).length >= 2) out += '<h5 style="margin-top:14px">Peso (kg)</h5>' + window.l360doc.linhas(datas, [{ nome: 'Peso', pontos: pp }], 560, 160, ' kg');
        return out;
      }
      window.l360grafico = graficoSeg;
      function leituraSeg() {
        var v = visitas(); if (v.length < 2) return [];
        var a = v[0], u = v[v.length - 1], le = [];
        CIRC.forEach(function (c) {
          var x = a[c[0]], y = u[c[0]]; if (x == null || y == null) return;
          var d = y - x, p = d / x * 100;
          le.push(c[1] + ': ' + (d === 0 ? 'sem variação' : (d < 0 ? 'redução de ' : 'aumento de ') + f1(Math.abs(d)) + ' cm (' + f1(Math.abs(p)) + '%)') + ' entre ' + fd(a.data) + ' e ' + fd(u.data) + '.');
        });
        if (u.coxamD != null && u.coxamE != null) { var as = Math.abs(u.coxamD - u.coxamE) / ((u.coxamD + u.coxamE) / 2) * 100; le.push('Assimetria da coxa média na última visita: ' + f1(as) + '% entre os lados' + (as < 3 ? ' (simétrico, como costuma ser no lipedema).' : ' (assimetria a investigar, por exemplo componente linfático).')); }
        if (a.dor != null && u.dor != null) le.push('Dor: ' + f1(a.dor) + ' → ' + f1(u.dor) + ' (escala 0 a 10).');
        le.push('Dado descritivo: não há ponto de corte validado para resposta ao tratamento no lipedema; variações pequenas podem refletir erro de medida (reproduza o ponto de aferição).');
        return le;
      }
      function desenhar() {
        var v = visitas();
        var ev = document.getElementById('evol'), gr = document.getElementById('graf');
        if (!cod()) { ev.innerHTML = '<p>Informe o código do paciente e salve a primeira visita.</p>'; gr.innerHTML = ''; document.getElementById('grafico').innerHTML = ''; document.getElementById('leitura').innerHTML = ''; return; }
        if (!v.length) { ev.innerHTML = '<p>Nenhuma visita salva para ' + cod() + '.</p>'; gr.innerHTML = ''; document.getElementById('grafico').innerHTML = ''; document.getElementById('leitura').innerHTML = ''; return; }
        var primeira = v[0], ultima = v[v.length - 1], anterior = v.length > 1 ? v[v.length - 2] : null;
        var h = '<div class="tabela-rolavel"><table class="grade"><thead><tr><th>Medida</th><th>1ª visita</th><th>Anterior</th><th>Atual</th><th>Δ vs 1ª</th><th>Δ vs anterior</th></tr></thead><tbody>';
        function linha(rot, k) {
          var a = primeira[k], b = anterior ? anterior[k] : null, c = ultima[k];
          if (a == null && c == null) return '';
          return '<tr><td>' + rot + '</td><td>' + f1(a) + '</td><td>' + f1(b) + '</td><td>' + f1(c) + '</td><td>' + d1(c, a) + '</td><td>' + d1(c, b) + '</td></tr>';
        }
        h += linha('Peso (kg)', 'peso') + linha('Dor (0 a 10)', 'dor');
        SIT.forEach(function (s) {
          if (s[1]) { h += linha(NOMES[s[0]] + ' D (cm)', s[0] + 'D') + linha(NOMES[s[0]] + ' E (cm)', s[0] + 'E'); }
          else h += linha(NOMES[s[0]] + ' (cm)', s[0] + 'D');
        });
        h += '</tbody></table></div><p style="font-size:.84rem;color:var(--muted);margin:10px 0 0">' + v.length + ' visita(s): ' + v.map(function (x) { return fd(x.data) + ' <button type="button" data-rm="' + x.data + '" style="background:none;border:0;color:var(--muted);cursor:pointer;font:inherit;font-size:.8rem;text-decoration:underline">remover</button>'; }).join(' · ') + '</p>';
        ev.innerHTML = h;
        gr.innerHTML = spark(v, 'dor', 'Dor');
        var gg = graficoSeg(); document.getElementById('grafico').innerHTML = gg;
        var le = leituraSeg(); document.getElementById('leitura').innerHTML = le.length ? '<h5>O que o gráfico mostra</h5><ul>' + le.map(function (x) { return '<li>' + x + '</li>'; }).join('') + '</ul>' : '';
        var t = 'SEGUIMENTO ' + cod() + ' (' + v.length + ' visitas, de ' + fd(primeira.data) + ' a ' + fd(ultima.data) + ')\n' +
          'Peso: ' + f1(primeira.peso) + ' → ' + f1(ultima.peso) + ' kg. Dor: ' + f1(primeira.dor) + ' → ' + f1(ultima.dor) + '.\n' +
          SIT.map(function (s) { var a = primeira[s[0] + 'D'], c = ultima[s[0] + 'D']; var ae = primeira[s[0] + 'E'], ce = ultima[s[0] + 'E']; if (a == null && c == null) return ''; return NOMES[s[0]] + ': ' + f1(a) + ' → ' + f1(c) + (s[1] ? ' (D), ' + f1(ae) + ' → ' + f1(ce) + ' (E)' : '') + ' cm'; }).filter(Boolean).join('\n');
        if (le.length) t += '\n\nLeitura:\n- ' + le.join('\n- ');
        if (window.l360caso) window.l360caso.set('seguimento', { texto: t, codigo: cod() });
      }

      document.getElementById('b-salvar').addEventListener('click', function () {
        if (!cod()) { document.getElementById('cod').focus(); return; }
        var reg = { data: document.getElementById('data').value, peso: num('peso'), dor: num('dor') };
        SIT.forEach(function (s) { reg[s[0] + 'D'] = num(s[0] + 'D'); if (s[1]) reg[s[0] + 'E'] = num(s[0] + 'E'); });
        var t = lerTudo(); var arr = (t[cod()] || []).filter(function (x) { return x.data !== reg.data; }); arr.push(reg); t[cod()] = arr; gravarTudo(t);
        desenhar();
      });
      document.getElementById('evol').addEventListener('click', function (e) {
        var b = e.target.closest('[data-rm]'); if (!b) return;
        var t = lerTudo(); t[cod()] = (t[cod()] || []).filter(function (x) { return x.data !== b.getAttribute('data-rm'); }); gravarTudo(t); desenhar();
      });
      document.getElementById('cod').addEventListener('input', desenhar);
      document.getElementById('b-csv').addEventListener('click', function () {
        var v = visitas(); if (!v.length) return;
        var cols = ['data', 'peso', 'dor'].concat([].concat.apply([], SIT.map(function (s) { return s[1] ? [s[0] + 'D', s[0] + 'E'] : [s[0] + 'D']; })));
        var csv = cols.join(';') + '\n' + v.map(function (x) { return cols.map(function (c) { return x[c] == null ? '' : String(x[c]).replace('.', ','); }).join(';'); }).join('\n');
        var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' })); a.download = 'seguimento-' + cod() + '.csv'; a.click();
      });

      // volume por cones truncados
      function lista(id) { return document.getElementById(id).value.split(/[;,\s]+/).map(function (x) { return parseFloat(x.replace(',', '.')); }).filter(function (x) { return !isNaN(x); }); }
      function vol(c, h) { var s = 0; for (var i = 0; i < c.length - 1; i++) s += h / (12 * Math.PI) * (c[i] * c[i] + c[i] * c[i + 1] + c[i + 1] * c[i + 1]); return s; }
      function calcVol() {
        var h = num('vh'), d = lista('vd'), e = lista('ve'), out = '';
        if (!h || (d.length < 2 && e.length < 2)) { document.getElementById('vout').innerHTML = '<p>Informe ao menos dois níveis.</p>'; return; }
        var vd = d.length > 1 ? vol(d, h) : null, ve = e.length > 1 ? vol(e, h) : null;
        if (vd != null) out += '<div class="linha"><span>Direita</span><b>' + Math.round(vd) + ' mL</b></div>';
        if (ve != null) out += '<div class="linha"><span>Esquerda</span><b>' + Math.round(ve) + ' mL</b></div>';
        if (vd != null && ve != null) out += '<div class="linha"><span>Diferença entre os lados</span><b>' + Math.round(Math.abs(vd - ve)) + ' mL (' + f1(Math.abs(vd - ve) / Math.max(vd, ve) * 100) + '%)</b></div>';
        document.getElementById('vout').innerHTML = out;
      }
      ['vh', 'vd', 've'].forEach(function (id) { document.getElementById(id).addEventListener('input', calcVol); });
      var c = window.l360caso.get().seguimento; if (c && c.codigo) document.getElementById('cod').value = c.codigo;
      desenhar();
    })();
  </script>
  <script is:inline>
window.l360tool = {
  slug: 'seguimento',
  _ids: [['peso', 'Peso (kg)'], ['dor', 'Dor (0 a 10)'], ['cintD', 'Cintura (cm)'], ['quadD', 'Quadril (cm)'], ['bracoD', 'Braço D (cm)'], ['bracoE', 'Braço E (cm)'], ['coxapD', 'Coxa proximal D (cm)'], ['coxapE', 'Coxa proximal E (cm)'], ['coxamD', 'Coxa média D (cm)'], ['coxamE', 'Coxa média E (cm)'], ['joelhoD', 'Joelho D (cm)'], ['joelhoE', 'Joelho E (cm)'], ['pantD', 'Panturrilha D (cm)'], ['pantE', 'Panturrilha E (cm)'], ['tornD', 'Tornozelo D (cm)'], ['tornE', 'Tornozelo E (cm)']],
  rotulos: function () { var r = {}; window.l360tool._ids.forEach(function (x) { r[x[0]] = x[1]; }); return r; },
  coletar: function () { var o = {}; window.l360tool._ids.forEach(function (x) { o[x[0]] = num(x[0]); }); return o; },
  aplicar: function (d) { window.l360tool._ids.forEach(function (x) { setv(x[0], d[x[0]]); }); }
};
  </script>
</Ferramenta>
