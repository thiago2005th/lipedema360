---
export const prerender = false;
import Ferramenta from '../../layouts/Ferramenta.astro';
const fontes = [
  { ref: 'Amato ACM, Saucedo DZ, Santos KS, Benitti DA. Ultrasound criteria for lipedema diagnosis. Phlebology, 2021;36(8):651-658. DOI 10.1177/02683555211002340. PMID 33853452', nota: 'Fonte dos quatro pontos de medida, dos limiares e das características operacionais (AUC, sensibilidade e especificidade). 89 mulheres, 63 com lipedema, estudo unicêntrico.' },
  { ref: 'Amato ACM, Saucedo DZ. Reply letter to the editor regarding ultrasound examination for en-suite measurements in lipedema. Phlebology, 2022;37(4):314-315. DOI 10.1177/02683555211068953. PMID 35505601', nota: 'Esclarecimentos do grupo sobre a técnica de medida.' },
  { ref: 'Roteiro de exame e motor de interpretação: protocolo POCUS Lipedema, Dr. Thiago Cabral.', nota: 'A graduação da força da suspeita é uma regra de organização clínica, sem validação prospectiva.' },
];
---
<Ferramenta slug="laudo-ultrassom" fontes={fontes}>
  <div class="pocus-aviso">
    <b>A ultrassonografia corrobora, não confirma.</b> O diagnóstico de lipedema é clínico e não há padrão-ouro. Este roteiro transcreve o que você mede e observa: campo vazio vira “não registrado”, nada é presumido. A <i>força da suspeita</i> é uma heurística interna, não validada.
  </div>

  <section class="card-p">
    <h2 class="sub">Seus dados no laudo</h2>
    <p class="dica-p">Clínica, nome, registro e logo ficam no painel “Seu timbre”, acima. Aqui, o que é específico do exame. Fica salvo neste navegador.</p>
    <div class="campos">
      <div class="fld"><label for="equip">Equipamento</label><input id="equip" autocomplete="off" placeholder="ex.: Butterfly iQ+" /></div>
      <div class="fld"><label for="cidade">Cidade – UF</label><input id="cidade" autocomplete="off" placeholder="ex.: Cuiabá – MT" /></div>
    </div>
    <label class="opt" style="margin-top:12px"><input type="checkbox" id="mostraForca" checked /> <span>Mostrar a “força da suspeita” no laudo <small>desmarque para um laudo só descritivo</small></span></label>
  </section>

  <section class="card-p">
    <h2 class="sub"><span class="n">1</span> Identificação</h2>
    <details class="orient"><summary>Orientação do exame</summary><p>Paciente em ortostase, sem meia compressiva. Matriz linear até 15 MHz, preset de partes moles. Marque os pontos com lápis dermográfico e use gel abundante. Registre peso e altura.</p></details>
    <div class="campos">
      <div class="fld"><label for="nome">Paciente</label><input id="nome" autocomplete="off" /></div>
      <div class="fld"><label for="idade">Idade</label><input id="idade" inputmode="numeric" /><span class="un">anos</span></div>
      <div class="fld"><label for="data">Data do exame</label><input id="data" type="date" /></div>
      <div class="fld"><label for="peso">Peso</label><input id="peso" inputmode="decimal" /><span class="un">kg</span></div>
      <div class="fld"><label for="alt">Altura</label><input id="alt" inputmode="decimal" /><span class="un">cm</span></div>
      <div class="fld"><label>IMC</label><div class="calc" id="imc">—</div></div>
    </div>
  </section>

  <section class="card-p">
    <h2 class="sub"><span class="n">2</span> Mapeamento venoso e sinais clínicos</h2>
    <details class="orient"><summary>Orientação do exame</summary><p>Primeira etapa: avalie a insuficiência venosa, teste a dor à compressão de panturrilha e coxa (a insuficiência venosa isolada é indolor) e pesquise equimoses.</p></details>
    <div class="pergunta"><span>Insuficiência venosa</span><div class="seg" data-g="venosa"><button type="button" data-v="ausente">Ausente</button><button type="button" data-v="presente" data-alerta>Presente</button><button type="button" data-v="na">Não avaliada</button></div></div>
    <div class="fld"><label for="vdet">Detalhe venoso</label><input id="vdet" autocomplete="off" placeholder="ex.: refluxo em VSM esquerda" /></div>
    <div class="pergunta"><span>Dor à compressão de panturrilha ou coxa <small>reforça lipedema</small></span><div class="seg" data-g="dor"><button type="button" data-v="sim">Sim</button><button type="button" data-v="nao">Não</button></div></div>
    <div class="pergunta"><span>Equimoses fáceis <small>fragilidade capilar</small></span><div class="seg" data-g="equim"><button type="button" data-v="sim">Sim</button><button type="button" data-v="nao">Não</button></div></div>
  </section>

  <section class="card-p">
    <h2 class="sub"><span class="n">3</span> Medidas nos 4 pontos (epiderme até a fáscia muscular, mm)</h2>
    <details class="orient"><summary>Técnica de medida</summary><p>Apoie o transdutor no gel, sem comprimir. Meça da epiderme à fáscia muscular (aumente o ganho se preciso). Faça no mínimo três medidas por ponto, sempre dos dois lados. Digite a média ou as três medidas separadas por espaço, como <b>21,2 20,8 21,5</b>; o cálculo da média é automático.</p></details>
    <div class="pocus-fig">
      <svg viewBox="0 0 340 410" role="img" aria-label="Pontos A, B, C e D na perna, vista anterior" font-family="Instrument Sans,Segoe UI,Arial,sans-serif">
        <g transform="translate(40 0)"><path d="M86 8 C74 90 80 150 84 196 C86 262 90 322 95 388 L118 388 C122 322 134 262 144 196 C156 150 154 90 142 8 Z" fill="none" stroke="currentColor" stroke-opacity=".55" stroke-width="1.6"/>
        <ellipse cx="114" cy="196" rx="30" ry="9" fill="none" stroke="currentColor" stroke-opacity=".25"/>
        <g font-size="12" font-weight="700">
          <circle cx="114" cy="98" r="9" fill="#c9a66b"/><text x="114" y="102" text-anchor="middle" fill="#17130c">A</text>
          <circle cx="104" cy="266" r="9" fill="#c9a66b"/><text x="104" y="270" text-anchor="middle" fill="#17130c">B</text>
          <circle cx="142" cy="266" r="9" fill="#c9a66b"/><text x="142" y="270" text-anchor="middle" fill="#17130c">C</text>
          <circle cx="97" cy="346" r="9" fill="#c9a66b"/><text x="97" y="350" text-anchor="middle" fill="#17130c">D</text>
        </g></g>
        <g font-size="10.5" fill="currentColor" fill-opacity=".8">
          <text x="205" y="94">A · coxa anterior</text><text x="205" y="107" font-size="9.5" fill-opacity=".6">EIAS ↔ patela (borda sup.)</text>
          <text x="2" y="258" text-anchor="start" font-size="10.5">B · pré-tibial</text><text x="2" y="271" font-size="9.5" fill-opacity=".6">tuberosidade ↔ maléolo med.</text>
          <text x="205" y="262">C · face lateral</text><text x="205" y="275" font-size="9.5" fill-opacity=".6">fíbula ↔ maléolo lat.</text>
          <text x="2" y="342">D · supramaleolar</text><text x="2" y="355" font-size="9.5" fill-opacity=".6">5 cm acima do med.</text>
        </g>
      </svg>
      <p>Vista anterior, perna direita. Lado esquerdo: mesmos pontos, simétricos.</p>
    </div>
    <div class="tabela-rolavel">
      <table class="grade" id="grade">
        <thead><tr><th>Ponto</th><th>Direita</th><th>Esquerda</th><th>Limiar D / E</th><th>Leitura</th><th>Acurácia</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <p class="dica-p">Regra do protocolo: basta <b>uma</b> medida acima do limiar para sugerir lipedema na conclusão. Comparação estrita (maior que). Um asterisco (*) indica média calculada de várias medidas. A acurácia segue a ordem pré-tibial &gt; coxa &gt; lateral &gt; supramaleolar.</p>
  </section>

  <section class="card-p">
    <h2 class="sub"><span class="n">4</span> Sítio-controle e pontos complementares</h2>
    <details class="orient"><summary>Orientação do exame</summary><p>O sítio-controle fica fora dos membros inferiores. Em pós-abdominoplastia, não use o abdome. A comparação segmentar vale mais que o limiar isolado. Os pontos complementares não têm limiar de referência.</p></details>
    <div class="campos">
      <div class="fld"><label for="ctl_local">Local do sítio-controle</label><input id="ctl_local" list="ctl-sug" autocomplete="off" /><datalist id="ctl-sug"><option value="abdome periumbilical"></option><option value="braço"></option><option value="antebraço"></option><option value="dorso"></option></datalist></div>
      <div class="fld"><label for="ctl_med">Medida do controle</label><input id="ctl_med" inputmode="decimal" /><span class="un">mm, sem limiar</span></div>
    </div>
    <div class="pergunta"><span>Desproporção dos MMII em relação ao controle <small>achado de suporte</small></span><div class="seg" data-g="desp"><button type="button" data-v="sim">Sim</button><button type="button" data-v="nao">Não</button></div></div>
    <div class="tabela-rolavel">
      <table class="grade" id="comp">
        <thead><tr><th>Ponto complementar</th><th>Direita (mm)</th><th>Esquerda (mm)</th></tr></thead>
        <tbody>
          <tr><td>Culote / face lateral proximal da coxa</td><td><input id="cul_D" inputmode="decimal" /></td><td><input id="cul_E" inputmode="decimal" /></td></tr>
          <tr><td>Joelho medial / face interna proximal da perna</td><td><input id="joe_D" inputmode="decimal" /></td><td><input id="joe_E" inputmode="decimal" /></td></tr>
          <tr><td>Membro superior (braço)</td><td><input id="bra_D" inputmode="decimal" /></td><td><input id="bra_E" inputmode="decimal" /></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card-p">
    <h2 class="sub"><span class="n">5</span> Critérios qualitativos</h2>
    <details class="orient"><summary>Padrão típico de lipedema</summary><p>Derme preservada, ecogenicidade normal ou diminuída, septos em prateleira, simetria e pés poupados. Opções em vermelho são alerta para componente linfático.</p></details>
    <div class="pergunta"><span>Derme</span><div class="seg" data-g="derme"><button type="button" data-v="preservada">Preservada, interface nítida</button><button type="button" data-v="espessada" data-alerta>Espessada, perda da interface</button></div></div>
    <div class="pergunta"><span>Ecogenicidade do subcutâneo</span><div class="seg" data-g="eco"><button type="button" data-v="normal">Normal ou diminuída</button><button type="button" data-v="aumentada" data-alerta>Aumentada</button></div></div>
    <div class="pergunta"><span>Septos hiperecogênicos, aspecto em prateleira</span><div class="seg" data-g="septos"><button type="button" data-v="presentes">Presentes</button><button type="button" data-v="ausentes">Ausentes</button></div></div>
    <div class="pergunta"><span>Espessamento simétrico bilateral</span><div class="seg" data-g="simet"><button type="button" data-v="sim">Sim</button><button type="button" data-v="nao">Não</button></div></div>
    <div class="pergunta"><span>Pés</span><div class="seg" data-g="pes"><button type="button" data-v="poupados">Poupados</button><button type="button" data-v="acometidos" data-alerta>Acometidos / Stemmer +</button></div></div>
  </section>

  <section class="card-p">
    <h2 class="sub"><span class="n">6</span> Diferencial e sinais de alerta</h2>
    <div class="pergunta"><span>Líquido intersticial, áreas anecoicas <small>item obrigatório do laudo</small></span><div class="seg" data-g="liquido"><button type="button" data-v="ausente">Ausente</button><button type="button" data-v="presente" data-alerta>Presente</button></div></div>
    <div class="pergunta"><span>Padrão difuso <small>tronco e membros superiores proporcionalmente aumentados</small></span><div class="seg" data-g="difuso"><button type="button" data-v="nao">Não</button><button type="button" data-v="sim" data-alerta>Sim</button></div></div>
    <div class="pergunta"><span>Nódulos subcutâneos dolorosos <small>Dercum: pode coexistir, não altera a força</small></span><div class="seg" data-g="dercum"><button type="button" data-v="nao">Não</button><button type="button" data-v="sim">Sim</button></div></div>
    <details class="orient"><summary>Lipedema × linfedema ao ultrassom</summary>
      <div class="tabela-rolavel"><table class="grade">
        <thead><tr><th>Parâmetro</th><th>Lipedema</th><th>Linfedema</th></tr></thead>
        <tbody>
          <tr><td>Derme</td><td>Preservada</td><td>Espessada</td></tr>
          <tr><td>Interface derme/subcutâneo</td><td>Nítida</td><td>Perdida</td></tr>
          <tr><td>Ecogenicidade do subcutâneo</td><td>Normal ou diminuída</td><td>Aumentada</td></tr>
          <tr><td>Líquido intersticial</td><td>Ausente</td><td>Lâminas anecoicas, com reforço posterior</td></tr>
          <tr><td>Septos em prateleira</td><td>Mais evidentes</td><td>Menos evidentes</td></tr>
          <tr><td>Espessura do subcutâneo</td><td>Aumentada</td><td>Aumentada (não discrimina sozinha)</td></tr>
          <tr><td>Pés</td><td>Poupados</td><td>Acometidos (Stemmer +)</td></tr>
        </tbody>
      </table></div>
    </details>
  </section>

  <section class="card-p">
    <h2 class="sub"><span class="n">7</span> Classificação clínica e observações</h2>
    <p class="dica-p">Tipo e estádio são clínicos, não ultrassonográficos, e o estádio não tem correlação validada com gravidade.</p>
    <div class="pergunta"><span>Tipo de distribuição</span><div class="seg" data-g="tipo"><button type="button" data-v="I">I · pelve e glúteos</button><button type="button" data-v="II">II · até os joelhos</button><button type="button" data-v="III">III · até os tornozelos</button><button type="button" data-v="IV">IV · braços</button><button type="button" data-v="V">V · perna isolada</button></div></div>
    <div class="pergunta"><span>Estádio morfológico</span><div class="seg" data-g="estadio"><button type="button" data-v="I">I · pele lisa</button><button type="button" data-v="II">II · irregular, nódulos</button><button type="button" data-v="III">III · lobos, deformidade</button><button type="button" data-v="IV">IV · lipolinfedema</button></div></div>
    <div class="fld"><label for="obs">Observações <small style="color:var(--muted)">entram na Análise</small></label><textarea id="obs" rows="3"></textarea></div>
  </section>

  <div class="res" id="res">
    <p class="kicker">Força da suspeita ultrassonográfica <small style="text-transform:none;letter-spacing:0;color:var(--muted)">· heurística interna, não validada</small></p>
    <div class="forca" id="forca"><div class="forca-barra"><i></i><i></i><i></i></div><div class="forca-rot" id="forca-rot">Preencha as medidas para graduar.</div></div>
    <ul class="just" id="just"></ul>
    <div class="pergunta"><span>Hipótese no laudo <small id="hip-auto"></small></span>
      <div class="seg" data-g="hip" data-unico>
        <button type="button" data-v="auto" class="on">Automática</button><button type="button" data-v="lipedema">Lipedema</button><button type="button" data-v="linfatico">Componente linfático</button><button type="button" data-v="difusa">Adiposidade difusa</button><button type="button" data-v="nao">Não sugestivo</button>
      </div>
    </div>
    <div class="pend" id="pend"></div>
    <p class="kicker" style="margin-top:22px">Laudo ao vivo</p>
    <textarea class="texto-saida" id="laudo" readonly></textarea>
    <div class="grafico-papel" id="grafico"></div>
    <details class="orient" style="margin-top:14px"><summary>Limites do método</summary>
      <ul class="lim">
        <li><b>Estudo de origem:</b> unicêntrico (89 mulheres; 63 com lipedema), sem validação externa.</li>
        <li><b>Comparação circular:</b> o grupo com lipedema foi definido pelo diagnóstico clínico e não existe padrão-ouro independente.</li>
        <li><b>Biótipo e etnia</b> podem gerar falso-positivo; a área corporal talvez importe mais que o IMC. <b>IMC acima de 25</b> reduz a especificidade dos limiares absolutos.</li>
        <li><b>Reprodutibilidade</b> é o principal ponto fraco (operador, compressão, ganho, referência anatômica).</li>
        <li><b>Seguimento:</b> os limiares não estão validados para monitorar resposta ao tratamento; use as medidas evolutivas como dado descritivo.</li>
        <li><b>Hipótese em prova de conceito:</b> aumento do fluxo microvascular no lipedema avançado (ultra-microangiografia). Não usar na decisão.</li>
      </ul>
    </details>
  </div>
  <div class="acoes-ferr">
    <button class="btn" id="b-copiar" type="button">Copiar laudo</button>
    <button class="btn sec" id="b-imprimir" type="button">Imprimir</button>
    <button class="btn sec" id="b-novo" type="button">Novo exame</button>
  </div>

  <script is:inline>
    (function () {
      var KD = 'pocus-lipedema-draft-v2', KP = 'l360_perfil';
      var LIM = [
        { id: 'A', nome: 'Coxa anterior', D: 19.5, E: 17.9, acc: 'Boa', auc: '0,87 / 0,89' },
        { id: 'B', nome: 'Pré-tibial', D: 11.6, E: 11.8, acc: 'Excelente', auc: '0,91 / 0,91' },
        { id: 'C', nome: 'Face lateral da perna', D: 8.9, E: 8.4, acc: 'Boa', auc: '0,89 / 0,89' },
        { id: 'D', nome: 'Supramaleolar medial', D: 7.1, E: 7.0, acc: 'Moderada', auc: '0,79 / 0,77' }
      ];
      var IN = ['nome', 'idade', 'data', 'peso', 'alt', 'vdet', 'ctl_local', 'ctl_med', 'cul_D', 'cul_E', 'joe_D', 'joe_E', 'bra_D', 'bra_E', 'obs', 'equip', 'cidade'];
      LIM.forEach(function (s) { IN.push('m_' + s.id + '_D', 'm_' + s.id + '_E'); });
      var GR = ['venosa', 'dor', 'equim', 'desp', 'derme', 'eco', 'septos', 'simet', 'pes', 'liquido', 'difuso', 'dercum', 'tipo', 'estadio', 'hip'];
      var ch = { hip: 'auto' };
      function $(id) { return document.getElementById(id); }
      function perfil() { try { return JSON.parse(localStorage.getItem(KP) || '{}') || {}; } catch (e) { return {}; } }

      $('grade').querySelector('tbody').innerHTML = LIM.map(function (s) {
        return '<tr><td><b>' + s.id + '</b> · ' + s.nome + '</td><td><input id="m_' + s.id + '_D" inputmode="decimal" placeholder="média ou 3 medidas" /></td><td><input id="m_' + s.id + '_E" inputmode="decimal" placeholder="média ou 3 medidas" /></td><td>' + f1(s.D) + ' / ' + f1(s.E) + ' mm</td><td id="r_' + s.id + '"></td><td><span class="acc acc-' + s.acc.toLowerCase() + '">' + s.acc + '</span><small>AUC ' + s.auc + '</small></td></tr>';
      }).join('');

      function media(txt) {
        var v = String(txt || '').trim().split(/\s+/).map(function (t) { return parseFloat(t.replace(',', '.')); }).filter(function (x) { return !isNaN(x); });
        if (!v.length) return null;
        return { m: v.reduce(function (a, b) { return a + b; }, 0) / v.length, n: v.length };
      }
      function mm(id) { var x = media($(id).value); return x ? x.m : null; }
      function dmy(iso) { if (!iso) return ''; var p = iso.split('-'); return p[2] + '/' + p[1] + '/' + p[0]; }
      function extenso(iso) {
        var d = iso ? new Date(iso + 'T12:00:00') : new Date(); if (isNaN(d)) d = new Date();
        return d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
      }
      function lista(a) { return a.length > 1 ? a.slice(0, -1).join(', ') + ' e ' + a[a.length - 1] : a.join(''); }

      var NIV = ['BAIXA', 'MODERADA', 'ALTA'];
      var HIPN = { lipedema: 'Lipedema', linfatico: 'Componente linfático (linfedema / lipolinfedema)', difusa: 'Adiposidade difusa', nao: 'Não sugestivo de lipedema' };

      function compute() {
        var r = { pos: [], sitesPos: [], medidas: 0, faltam: [], sup: [], lin: [], avisos: [], just: [], nivel: null };
        var preTib = false;
        LIM.forEach(function (s) {
          ['D', 'E'].forEach(function (l) {
            var v = mm('m_' + s.id + '_' + l);
            if (v == null) { r.faltam.push(s.id + l); return; }
            r.medidas++;
            if (v > s[l]) { r.pos.push(s.id + l); if (r.sitesPos.indexOf(s.id) < 0) r.sitesPos.push(s.id); if (s.id === 'B') preTib = true; }
          });
        });
        var p = num('peso'), a = num('alt');
        r.imc = (p && a) ? p / Math.pow(a / 100, 2) : null;
        if (ch.derme === 'preservada') r.sup.push('derme preservada');
        if (ch.eco === 'normal') r.sup.push('ecogenicidade normal ou diminuída');
        if (ch.septos === 'presentes') r.sup.push('septos em prateleira');
        if (ch.simet === 'sim') r.sup.push('simetria bilateral');
        if (ch.desp === 'sim') r.sup.push('desproporção em relação ao controle');
        if (ch.pes === 'poupados') r.sup.push('pés poupados');
        if (ch.dor === 'sim') r.sup.push('dor à compressão');
        if (ch.equim === 'sim') r.sup.push('equimoses fáceis');
        if (ch.derme === 'espessada') r.lin.push('derme espessada com perda de interface');
        if (ch.eco === 'aumentada') r.lin.push('ecogenicidade aumentada');
        if (ch.liquido === 'presente') r.lin.push('líquido intersticial');
        if (ch.pes === 'acometidos') r.lin.push('pés acometidos');
        var dif = ch.difuso === 'sim';
        if (r.medidas) {
          var n;
          if (!r.pos.length) {
            n = 0; r.just.push('Nenhuma medida acima dos limiares.');
            if (r.sup.length >= 3) r.avisos.push('Há ' + r.sup.length + ' achados de suporte, mas as medidas estão abaixo dos limiares.');
          } else {
            n = 1; r.just.push(r.pos.length + ' medida(s) acima do limiar: ' + r.pos.join(', ') + '.');
            if ((preTib || r.sitesPos.length >= 2) && r.sup.length >= 2) { n = 2; r.just.push('Pré-tibial positivo ou 2 ou mais pontos positivos, com ' + r.sup.length + ' achados de suporte.'); }
          }
          if (r.sup.length) r.just.push('Achados de suporte (' + r.sup.length + '): ' + r.sup.join('; ') + '.');
          if (r.imc != null && r.imc > 25) {
            r.avisos.push('IMC acima de 25 kg/m²: perda de especificidade dos limiares.');
            if (n === 2 && ch.desp !== 'sim') { n = 1; r.just.push('Rebaixada para Moderada: IMC acima de 25 sem desproporção documentada.'); }
          }
          if (r.lin.length) { n = Math.max(0, n - 1); r.just.push('Sinais linfáticos (' + r.lin.join('; ') + '): cai um nível.'); }
