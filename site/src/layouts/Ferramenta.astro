---
import Base from './Base.astro';
import PacienteBarra from '../components/PacienteBarra.astro';
import { artigos, tituloExibido, fmtData, nivelEvidencia } from '../lib/data';
import { AVISO, FERRAMENTAS, type Fonte } from '../lib/ferramentas';
interface Props { slug: string; fontes: Fonte[]; }
const { slug, fontes } = Astro.props;
const f = FERRAMENTAS.find((x) => x.slug === slug)!;
const novos = f.palavras.length
  ? artigos
      .filter((a) => {
        const t = (a.titulo + ' ' + a.keywords.join(' ') + ' ' + a.mesh.join(' ')).toLowerCase();
        return f.palavras.some((p) => t.includes(p)) && nivelEvidencia(a) >= 3;
      })
      .slice(0, 4)
  : [];
---
<Base titulo={f.nome} descricao={f.resumo}>
  <script is:inline>
    (function () {
      var K = 'l360_caso';
      function ler() { try { return JSON.parse(localStorage.getItem(K) || '{}'); } catch (e) { return {}; } }
      window.l360caso = {
        get: ler,
        set: function (chave, valor) { var c = ler(); c[chave] = valor; c._atualizado = new Date().toISOString(); try { localStorage.setItem(K, JSON.stringify(c)); } catch (e) {} },
        limpar: function () { try { localStorage.removeItem(K); } catch (e) {} }
      };
      window.copiar = function (texto, botao) {
        var ok = function () { if (!botao) return; var t = botao.textContent; botao.textContent = 'Copiado'; setTimeout(function () { botao.textContent = t; }, 1800); };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(texto).then(ok, function () { prompt('Copie o texto:', texto); });
        else { var x = document.createElement('textarea'); x.value = texto; document.body.appendChild(x); x.select(); try { document.execCommand('copy'); ok(); } catch (e) {} document.body.removeChild(x); }
      };
      window.num = function (id) { var v = parseFloat(String(document.getElementById(id).value).replace(',', '.')); return isNaN(v) ? null : v; };
      window.f1 = function (n) { return n == null ? '—' : n.toFixed(1).replace('.', ','); };
      window.f2 = function (n) { return n == null ? '—' : n.toFixed(2).replace('.', ','); };
      window.setv = function (id, v) { var e = document.getElementById(id); if (!e) return; e.value = v == null ? '' : v; e.dispatchEvent(new Event('input', { bubbles: true })); };
      window.marcar = function (el, on) { if (!el) return; el.checked = !!on; el.dispatchEvent(new Event('change', { bubbles: true })); };
    })();
  </script>

  <script is:inline src="/doc.js"></script>

  <div class="ferr">
    <div class="ferr-main">
      <p class="eyebrow">{f.categoria} · <span style="color:var(--muted)">Profissional</span></p>
      <h1>{f.nome}</h1>
      <p class="lead">{f.resumo}</p>
      <p class="aviso-ferr">{AVISO}</p>
      <details class="timbre" id="timbre">
        <summary><span>Seu timbre: logo e dados da clínica <small id="pf-resumo">· ainda não configurado</small></span></summary>
        <div class="timbre-corpo">
          <p class="dica">Aparece no cabeçalho de todo laudo, nota e plano que você imprimir ou salvar em PDF. Fica salvo neste navegador; não é enviado a nenhum servidor.</p>
          <div class="timbre-grade">
            <div class="fld"><label for="pf-clinica">Clínica ou consultório</label><input id="pf-clinica" autocomplete="off" placeholder="Clínica Exemplo" /></div>
            <div class="fld"><label for="pf-prof">Profissional</label><input id="pf-prof" autocomplete="off" placeholder="Dra. Maria Souza" /></div>
            <div class="fld"><label for="pf-reg">Registro</label><input id="pf-reg" autocomplete="off" placeholder="CRM-SP 000000 · RQE 0000" /></div>
            <div class="fld"><label for="pf-contato">Contato</label><input id="pf-contato" autocomplete="off" placeholder="(11) 90000-0000 · @suaclinica · endereço" /></div>
          </div>
          <div class="timbre-logo">
            <img id="pf-logo-img" alt="Seu logo" hidden />
            <label class="btn sec" for="pf-logo" style="cursor:pointer">Escolher logo</label>
            <input id="pf-logo" type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" />
            <button class="btn sec" id="pf-logo-rm" type="button" hidden>Remover logo</button>
            <span class="timbre-ok" id="pf-msg"></span>
          </div>
        </div>
      </details>
      <PacienteBarra />
      <slot />
      <div class="doc-bar" id="doc-bar">
        <button class="btn" id="doc-pdf" type="button">Imprimir / salvar PDF</button>
        <span>No diálogo de impressão, escolha “Salvar como PDF”. O documento sai com o seu timbre.</span>
      </div>
    </div>
    <aside class="ferr-lado">
      <div class="fonte-box">
        <h4>Baseado em</h4>
        <ul>
          {fontes.map((s) => (
            <li>{s.ref}{s.nota && <em>{s.nota}</em>}</li>
          ))}
        </ul>
      </div>
      {novos.length > 0 && (
        <div class="fonte-box novos">
          <h4>Evidência nova para esta ferramenta</h4>
          <ul>
            {novos.map((a) => (
              <li><a href={`/artigos/${a.pmid}`}>{tituloExibido(a)}</a><span>{fmtData(a.data)}</span></li>
            ))}
          </ul>
        </div>
      )}
      <a class="btn sec" href="/ferramentas" style="text-align:center">← Todas as ferramentas</a>
      <a href="/entrar?sair=1" style="text-align:center;font-size:.8rem;color:var(--muted)">Sair da conta</a>
    </aside>
  </div>
</Base>
