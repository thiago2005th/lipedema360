---
import { AREAS, TIPOS } from '../lib/data';
interface Props { total: number; recentes: number; noAno: number; altos: number }
const { total, recentes, noAno, altos } = Astro.props;
const nAreas = Object.keys(AREAS).length;
---
<section class="capa" id="capa">
  <canvas id="const" aria-hidden="true"></canvas>
  <div class="capa-txt wrap">
    <p class="eyebrow">Inteligência científica em lipedema</p>
    <h1>A ciência do lipedema, <em>em foco.</em></h1>
    <p class="capa-sub">Cada estudo do PubMed, classificado por evidência e resumido em português.</p>
    <form class="busca-hero" action="/busca" method="get" role="search">
      <input id="q" name="q" type="search" placeholder="Tratamento, técnica, autor…" aria-label="Buscar artigos" autocomplete="off" />
      <button type="submit">Buscar</button>
    </form>
    <div class="sugestoes">
      <a href="/busca?q=lipoaspira%C3%A7%C3%A3o">lipoaspiração</a>
      <a href="/busca?q=cetog%C3%AAnica">dieta cetogênica</a>
      <a href="/busca?q=compress%C3%A3o">compressão</a>
      <a href="/busca?q=GLP-1">GLP-1</a>
    </div>
  </div>
  <div class="capa-rodape wrap">
    <div class="stats">
      <div><b>{total}</b>estudos na base</div>
      <div><b>{nAreas}</b>áreas clínicas</div>
      <div><b>{recentes}</b>nos últimos 30 dias</div>
      <div><b>{altos}</b>de alta evidência no ano</div>
    </div>
    <p class="legenda-const"><span class="ponto"></span> Cada ponto é um estudo. Dourado = alta evidência. Passe o mouse e clique.</p>
  </div>
  <div class="tip" id="tip" hidden></div>
</section>

<script is:inline define:vars={{ AREAS, TIPOS }}>
  (function () {
    var sec = document.getElementById('capa'), cv = document.getElementById('const'), tip = document.getElementById('tip');
    if (!sec || !cv) return;
    var ctx = cv.getContext('2d');
    var reduz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var areaKeys = Object.keys(AREAS), nA = areaKeys.length;
    var W = 0, H = 0, dpr = 1, stars = [], dust = [], centers = [], tempo = 0, visivel = true, rodando = false;
    var mouse = { x: -9999, y: -9999, ativo: false }, hover = null;
    var temLS = 'letterSpacing' in ctx;

    function semente(s) { var h = 2166136261; for (var i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return function () { h += 0x6D2B79F5; var t = Math.imul(h ^ (h >>> 15), 1 | h); t ^= t + Math.imul(t ^ (t >>> 7), 61 | t); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }

    function layout() {
      var r = sec.getBoundingClientRect();
      W = r.width; H = r.height; dpr = Math.min(window.devicePixelRatio || 1, 2);
      cv.width = W * dpr; cv.height = H * dpr; cv.style.width = W + 'px'; cv.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      var largo = W > 720, amplo = W > 1100;
      var cx0 = amplo ? W * 0.68 : largo ? W * 0.76 : W * 0.5, cy0 = largo ? H * 0.5 : H * 0.62;
      var rx = amplo ? Math.min(W * 0.24, 360) : largo ? W * 0.14 : W * 0.3, ry = largo ? H * 0.3 : H * 0.2;
      var esc = amplo ? 1 : largo ? 0.7 : 0.55;
      centers = areaKeys.map(function (k, i) {
        var a = (i / nA) * Math.PI * 2 - Math.PI / 2 + 0.35;
        return { k: k, nome: AREAS[k].curto, x: cx0 + Math.cos(a) * rx, y: cy0 + Math.sin(a) * ry, n: 0, esp: 0, dir: i % 2 ? 1 : -1, calor: 0 };
      });
      stars.forEach(function (s) { centers[s.a].n++; });
      centers.forEach(function (c) { c.esp = Math.min(34 + Math.sqrt(c.n) * 3.4, 120) * esc; });
      stars.forEach(function (s) { var c = centers[s.a]; s.ox = Math.cos(s.ang) * s.rad * c.esp; s.oy = Math.sin(s.ang) * s.rad * c.esp * 0.8; if (!s.pronto) { s.x = c.x + s.ox; s.y = c.y + s.oy; s.pronto = true; } });
      dust = []; var rnd = semente('poeira'); var nd = Math.round(W * H / 9000);
      for (var i = 0; i < nd; i++) dust.push({ x: rnd() * W, y: rnd() * H, r: rnd() * 1.1 + 0.2, f: rnd() * 6.28, v: rnd() * 0.06 + 0.01 });
    }

    function montar(dados) {
      stars = dados.map(function (d) {
        var rnd = semente(d.p), ai = Math.max(0, areaKeys.indexOf(d.a));
        return { p: d.p, t: d.t, ty: d.y, ano: d.d.slice(0, 4), e: d.e, a: ai, ang: rnd() * 6.2832, rad: Math.sqrt(rnd()), prof: 0.4 + rnd() * 0.9, fase: rnd() * 6.28, x: 0, y: 0, vx: 0, vy: 0, ox: 0, oy: 0, pronto: false };
      });
      layout();
    }

    function passo() {
      tempo += 1;
      var R = 130, R2 = R * R, mx = mouse.x, my = mouse.y, px = (mx - W / 2) / W, py = (my - H / 2) / H;
      var melhor = null, melhorD = 30 * 30;
      for (var i = 0; i < stars.length; i++) {
        var s = stars[i], c = centers[s.a];
        var w = tempo * 0.0016 * c.dir, cs = Math.cos(w), sn = Math.sin(w);
        var tx = c.x + s.ox * cs - s.oy * sn, ty = c.y + s.ox * sn + s.oy * cs;
        if (mouse.ativo) { tx += px * (s.prof - 0.8) * 46; ty += py * (s.prof - 0.8) * 46; }
        s.vx += (tx - s.x) * 0.035; s.vy += (ty - s.y) * 0.035;
        if (mouse.ativo) {
          var dx = s.x - mx, dy = s.y - my, d2 = dx * dx + dy * dy;
          if (d2 < R2 && d2 > 0.01) { var d = Math.sqrt(d2), f = (1 - d / R); f = f * f * 0.9; s.vx += (dx / d) * f; s.vy += (dy / d) * f; }
          if (d2 < melhorD) { melhorD = d2; melhor = s; }
        }
        s.vx *= 0.86; s.vy *= 0.86; s.x += s.vx; s.y += s.vy;
      }
      hover = melhor;
      centers.forEach(function (c) {
        var dx = c.x - mx, dy = c.y - my, perto = mouse.ativo && dx * dx + dy * dy < (c.esp + 40) * (c.esp + 40);
        c.calor += ((perto ? 1 : 0) - c.calor) * 0.08;
      });
    }

    function desenhar() {
      ctx.clearRect(0, 0, W, H);
      var i, s, c;
      for (i = 0; i < dust.length; i++) {
        var d = dust[i], a = 0.18 + 0.14 * Math.sin(tempo * 0.02 * d.v * 10 + d.f);
        if (!reduz) { d.y -= d.v * 0.25; if (d.y < -2) d.y = H + 2; }
        ctx.fillStyle = 'rgba(242,237,229,' + a.toFixed(3) + ')'; ctx.beginPath(); ctx.arc(d.x, d.y, d.r, 0, 6.2832); ctx.fill();
      }
      for (i = 0; i < centers.length; i++) {
        c = centers[i];
        var g = ctx.createRadialGradient(c.x, c.y, 0, c.x, c.y, c.esp * 1.9);
        g.addColorStop(0, 'rgba(201,166,107,' + (0.06 + c.calor * 0.12).toFixed(3) + ')'); g.addColorStop(1, 'rgba(201,166,107,0)');
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(c.x, c.y, c.esp * 1.9, 0, 6.2832); ctx.fill();
      }
      if (mouse.ativo) {
        var perto = [];
        for (i = 0; i < stars.length; i++) { s = stars[i]; var dx = s.x - mouse.x, dy = s.y - mouse.y; if (dx * dx + dy * dy < 150 * 150) perto.push(s); }
        if (perto.length > 70) perto.length = 70;
        ctx.lineWidth = 0.7;
        for (i = 0; i < perto.length; i++) for (var j = i + 1; j < perto.length; j++) {
          var ddx = perto[i].x - perto[j].x, ddy = perto[i].y - perto[j].y, dd = ddx * ddx + ddy * ddy;
          if (dd < 62 * 62) { ctx.strokeStyle = 'rgba(224,196,143,' + (0.5 * (1 - Math.sqrt(dd) / 62)).toFixed(3) + ')'; ctx.beginPath(); ctx.moveTo(perto[i].x, perto[i].y); ctx.lineTo(perto[j].x, perto[j].y); ctx.stroke(); }
        }
      }
      for (i = 0; i < stars.length; i++) {
        s = stars[i];
        var alta = s.e >= 4, tw = 0.72 + 0.28 * Math.sin(tempo * 0.03 + s.fase), raio = 0.9 + s.e * 0.42;
        var dxm = s.x - mouse.x, dym = s.y - mouse.y, prox = mouse.ativo ? Math.max(0, 1 - Math.sqrt(dxm * dxm + dym * dym) / 150) : 0;
        if (alta) {
          ctx.fillStyle = 'rgba(224,196,143,' + (0.10 + prox * 0.18).toFixed(3) + ')'; ctx.beginPath(); ctx.arc(s.x, s.y, raio * 3.4, 0, 6.2832); ctx.fill();
          ctx.fillStyle = 'rgba(232,206,152,' + Math.min(1, (0.85 + prox * 0.15) * tw).toFixed(3) + ')';
        } else {
          ctx.fillStyle = 'rgba(242,237,229,' + Math.min(1, (0.42 + prox * 0.5) * tw).toFixed(3) + ')';
        }
        ctx.beginPath(); ctx.arc(s.x, s.y, raio * (1 + prox * 0.35), 0, 6.2832); ctx.fill();
      }
      if (hover) {
        ctx.strokeStyle = 'rgba(232,206,152,.95)'; ctx.lineWidth = 1.2; ctx.beginPath(); ctx.arc(hover.x, hover.y, 9 + Math.sin(tempo * 0.12) * 1.2, 0, 6.2832); ctx.stroke();
      }
      ctx.font = '600 10.5px "Instrument Sans", system-ui, sans-serif'; ctx.textAlign = 'center';
      if (temLS) ctx.letterSpacing = '1.6px';
      for (i = 0; i < centers.length; i++) {
        c = centers[i];
        ctx.fillStyle = 'rgba(224,196,143,' + (0.38 + c.calor * 0.6).toFixed(3) + ')';
        ctx.fillText(c.nome.toUpperCase(), c.x, c.y - c.esp - 14 - c.calor * 3);
      }
      if (temLS) ctx.letterSpacing = '0px';
    }

    function atualizarTip() {
      if (hover) {
        var t = hover.t.length > 120 ? hover.t.slice(0, 117) + '…' : hover.t;
        tip.innerHTML = '<span class="tip-t">' + (TIPOS[hover.ty] || '') + ' · ' + hover.ano + '</span><span class="tip-h"></span><span class="tip-a">Abrir estudo →</span>';
        tip.querySelector('.tip-h').textContent = t;
        tip.hidden = false;
        var x = hover.x + 16, y = hover.y + 16, tw = 280;
        if (x + tw > W - 12) x = hover.x - tw - 16;
        tip.style.left = Math.max(12, x) + 'px'; tip.style.top = Math.min(H - 110, y) + 'px';
        sec.style.cursor = 'pointer';
      } else { if (!tip.hidden) tip.hidden = true; sec.style.cursor = ''; }
    }

    function loop() { if (!visivel) { rodando = false; return; } passo(); desenhar(); atualizarTip(); requestAnimationFrame(loop); }
    function iniciar() { if (rodando) return; rodando = true; requestAnimationFrame(loop); }

    function mover(e) {
      var r = sec.getBoundingClientRect(), p = e.touches ? e.touches[0] : e;
      mouse.x = p.clientX - r.left; mouse.y = p.clientY - r.top; mouse.ativo = true;
      if (reduz) { passo(); desenhar(); atualizarTip(); }
    }
    sec.addEventListener('pointermove', mover);
    sec.addEventListener('pointerleave', function () { mouse.ativo = false; mouse.x = mouse.y = -9999; hover = null; });
    sec.addEventListener('click', function (e) { if (hover && !e.target.closest('a,button,input,form')) location.href = '/artigos/' + hover.p; });
    window.addEventListener('resize', function () { if (stars.length) layout(); });
    if ('IntersectionObserver' in window) new IntersectionObserver(function (en) { visivel = en[0].isIntersecting; if (visivel && !reduz) iniciar(); }).observe(sec);

    fetch('/search.json').then(function (r) { return r.json(); }).then(function (d) {
      montar(d);
      if (reduz) { passo(); desenhar(); } else iniciar();
    }).catch(function () {});
  })();
</script>
